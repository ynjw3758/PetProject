package com.Pets.Platform.service;

import java.util.ArrayList;


import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.stereotype.Service;

import com.Pets.Platform.entity.ChatUserInfo;
import com.Pets.Platform.mongo.Chat;
import com.fasterxml.jackson.databind.ObjectMapper;

@Service
public class Services {
	
	private Logger logger = LoggerFactory.getLogger(this.getClass());
	
	@Autowired
	private Chat Mongo;
	
	public Map<String, Object> ChatInfos(Map<String, Object> info){
		Map<String, Object> data = new HashMap<>();
		data =Mongo.getChatInfos(info);
		
		return data;
	}
	
	public Map<String, Object> Reload(String Id){
		Map<String, Object> data = new HashMap<>();
		data = Mongo.getReaload(Id);
		return data;
	}
	
	public Map<String, Object>FocusChatinfo( Map<String, Object>Id){
		Map<String, Object> data = new HashMap<>();
		Map<String, Object> Total_info = new HashMap<>();
		Total_info = Mongo.getFocusinfos(Id.get("Id").toString(), Id.get("ChatId").toString());
		logger.info("조회 통합 정보 :" + Total_info);
		if(Total_info.isEmpty()) {
			data.put("code", 404);
			data.put("msg", "데이터가 존재하지 않는다.");
			data.put("data", "null");
		}
		else {
			data.put("code", 200);
			data.put("succode", "01");
			data.put("msg", "success");
			data.put("data", Total_info);
			
		}
		
		return data;
	}

	public Map<String, Object>createRoom(Map<String, Object> infos){
		Map<String, Object> result = new HashMap<String, Object>();
		logger.info("채팅 생성 시작 :" + infos);
		List<Map<String, Object>> list = new ArrayList<>();
		String chat_name =infos.get("Name").toString(); 
		list = (List<Map<String, Object>>) infos.get("list");
		String Manager =infos.get("Id").toString(); 
		String Myprofile =infos.get("MyProfile").toString(); 
		String Nickname= infos.get("Nickname").toString(); 
		logger.info("리스트 데이터 :" + list);
		result= Mongo.Create_Chat(list, chat_name,Manager ,Myprofile ,Nickname);
		
		return result;
		
	}

}
