package com.Pets.Platform.mongo;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.Collection;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.UUID;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.data.mongodb.core.query.Update;
import org.springframework.scheduling.annotation.Async;

import com.Pets.Platform.dto.ChatUerinfoDto;
import com.Pets.Platform.entity.ChatRoom;
import com.Pets.Platform.entity.ChatUserInfo;

@Service
public class Chat {
	
	private Logger logger = LoggerFactory.getLogger(this.getClass());
	
	@Autowired
	private MongoTemplate mongo_template;
	
	@Async
	@Transactional
	public void Insert_Async(ChatRoom room, List<ChatUserInfo> all_insert) {
		 mongo_template.save(room);
		 mongo_template.insertAll(all_insert);
		return ;
	}
	
	 
	public Map<String, Object> Create_Chat(List<Map<String, Object>> list, String name, String manager, 
			String Img, String NickName) {
		Map<String, Object> result = new HashMap<String, Object>();
		  String uuid = UUID.randomUUID().toString();
		  //ChatUserInfo info = new ChatUserInfo();
		  ChatRoom room =new ChatRoom();
		  List<ChatUserInfo> all_insert = new ArrayList<ChatUserInfo>();
		  int same_cnt=0;
		  boolean isCreate= false;
		  Map<String, Object> ischeck = new HashMap<String, Object>();
		  Map<String, Object> my_info = new HashMap<String, Object>();
		  Map<String ,Object> myinfo =new HashMap<String, Object>();
		  List<String> my_chat = new ArrayList<String>();
		  List<List<String>> people_chat = new ArrayList<List<String>>();
		  List<String> uuid_list = new ArrayList<String>();
		  
		  myinfo.put("Img", Img);
		  myinfo.put("Nickname", NickName);
		  myinfo.put("Userid", manager);
		  list.add(myinfo);
		  
		  uuid_list.add(uuid);
		  
		  for(int i=0; i< list.size() ; i++) {
			  if(i ==0) {
				  Query query = new Query(Criteria.where("user_Id").is(manager));
				  my_info = mongo_template.findOne(query, Map.class, "UserInfo");
				  if(my_info == null) {
	  				  ChatUserInfo info = new ChatUserInfo(uuid_list, manager, NickName, Img);
	  	              all_insert.add(info);
				  }
				  else {
					  my_chat=(List<String>) my_info.get("ChatRoom");
				  }
			  }
			  if(list.get(i).get("Userid").equals(manager)) continue;
			  else {
			      String userId=list.get(i).get("Userid").toString();
				  Query other_query = new Query(Criteria.where("user_Id")
						  .is(userId));
				  ischeck = mongo_template.findOne(other_query, Map.class, "UserInfo");
			      logger.info("조회 결과 :" +ischeck );
			  }
			  if(ischeck == null || isCreate == true) {
				  isCreate = true;
				  logger.info("한 명이라도 채팅방을 새로 생성한다면 이 방은 그냥 생성한다. 줃복 처리 안해도됨");
				  if(list.get(i).get("Img").toString().equals("/image/baseimg.png")) {
				          
		  				  ChatUserInfo info = new ChatUserInfo(uuid_list, list.get(i).get("Userid").toString(), 
		  			              list.get(i).get("Nickname").toString(), "N"
		  			              );
		  	                      all_insert.add(info);
				  }
				  else {
				  	  ChatUserInfo info = new ChatUserInfo(uuid_list, list.get(i).get("Userid").toString(), 
					  list.get(i).get("Nickname").toString(), list.get(i).get("Img").toString() 
					  );
			          all_insert.add(info);
				  }

			  }
			  else {
				  logger.info("기존의 채팅방에 참여했던 사람 중복 처리해줘야 한다");
				  people_chat.add((List<String>) ischeck.get("ChatRoom"));
			  }
		  }
		  if(isCreate == true) {
			  int User_Count= list.size();
			  String chatname = String.join(",", name);
			 LocalDateTime createDate = LocalDateTime.now();
			 room.setUserCount(User_Count);
			 room.setUuid(uuid);
			 room.setRoomName(chatname);
			 Insert_Async(room ,all_insert);
			 result.put("msg", "채팅방 생성 중");
			 result.put("data", );

		  }
		  else {
			  logger.info("나의 채팅방 리스트 :" + my_chat);
			  logger.info("다른 채팅방 리스트 :" + people_chat);
			  
		  }

		 
		  return result;
	}
        
}
